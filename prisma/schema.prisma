generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ERP-facing lifecycle status of a payment order.
enum PaymentStatus {
  CREATED           // Row reserved locally; Cashfree order not confirmed yet
  ACTIVE            // Cashfree order exists, awaiting payment
  PENDING           // A payment attempt is pending at the bank/gateway
  FAILED            // Latest attempt failed; order still payable until expiry
  USER_DROPPED      // Latest attempt abandoned by user; order still payable until expiry
  PAID              // Money captured
  EXPIRED           // Order expired without a successful payment
  CANCELLED         // Order terminated by the ERP
  INITIATION_FAILED // Cashfree rejected or never created the order
  PARTIALLY_REFUNDED
  REFUNDED
}

/// Raw Cashfree payment-attempt status (mirrors the gateway).
enum TransactionStatus {
  SUCCESS
  NOT_ATTEMPTED
  PENDING
  FAILED
  USER_DROPPED
  CANCELLED
  VOID
  UNKNOWN
}

enum RefundStatus {
  PENDING
  ONHOLD
  SUCCESS
  CANCELLED
  FAILED // Never accepted by Cashfree
}

enum EventSource {
  API
  WEBHOOK
  RETURN_URL
  RECONCILIATION
}

enum WebhookProcessingStatus {
  RECEIVED
  PROCESSED
  IGNORED
  FAILED
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

model PaymentOrder {
  id                String        @id @default(uuid()) @db.Uuid
  /// Merchant order id sent to Cashfree (also the public id used by the ERP).
  orderId           String        @unique @map("order_id") @db.VarChar(45)
  cfOrderId         String?       @map("cf_order_id") @db.VarChar(64)
  studentId         String        @map("student_id") @db.VarChar(64)
  /// ERP fee invoice / demand reference this payment settles.
  feeReference      String        @map("fee_reference") @db.VarChar(64)
  purpose           String        @db.VarChar(64)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @default("INR") @db.Char(3)
  status            PaymentStatus @default(CREATED)
  cfOrderStatus     String?       @map("cf_order_status") @db.VarChar(32)
  paymentSessionId  String?       @map("payment_session_id")
  customerName      String?       @map("customer_name") @db.VarChar(100)
  customerEmail     String?       @map("customer_email") @db.VarChar(254)
  customerPhone     String        @map("customer_phone") @db.VarChar(20)
  returnUrl         String?       @map("return_url")
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(128)
  requestHash       String        @map("request_hash") @db.Char(64)
  metadata          Json?
  /// Set when the order needs human attention (amount mismatch, late success, ...).
  flaggedReason     String?       @map("flagged_reason") @db.VarChar(255)
  lastGatewayError  String?       @map("last_gateway_error")
  expiresAt         DateTime?     @map("expires_at") @db.Timestamptz(3)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  lastSyncedAt      DateTime?     @map("last_synced_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  transactions PaymentTransaction[]
  refunds      Refund[]
  events       PaymentEvent[]

  @@index([studentId, createdAt])
  @@index([feeReference])
  @@index([status, lastSyncedAt])
  @@map("payment_orders")
}

/// One row per Cashfree payment attempt (cf_payment_id) under an order.
model PaymentTransaction {
  id             String            @id @default(uuid()) @db.Uuid
  paymentOrderId String            @map("payment_order_id") @db.Uuid
  cfPaymentId    String            @unique @map("cf_payment_id") @db.VarChar(64)
  status         TransactionStatus
  amount         Decimal           @db.Decimal(12, 2)
  currency       String            @default("INR") @db.Char(3)
  paymentGroup   String?           @map("payment_group") @db.VarChar(64)
  bankReference  String?           @map("bank_reference") @db.VarChar(128)
  message        String?
  errorDetails   Json?             @map("error_details")
  paymentTime    DateTime?         @map("payment_time") @db.Timestamptz(3)
  completedAt    DateTime?         @map("completed_at") @db.Timestamptz(3)
  raw            Json
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([paymentOrderId])
  @@map("payment_transactions")
}

model Refund {
  id               String       @id @default(uuid()) @db.Uuid
  paymentOrderId   String       @map("payment_order_id") @db.Uuid
  /// Merchant refund id sent to Cashfree.
  refundId         String       @unique @map("refund_id") @db.VarChar(40)
  cfRefundId       String?      @map("cf_refund_id") @db.VarChar(64)
  amount           Decimal      @db.Decimal(12, 2)
  status           RefundStatus @default(PENDING)
  reason           String?      @db.VarChar(100)
  idempotencyKey   String       @unique @map("idempotency_key") @db.VarChar(128)
  requestHash      String       @map("request_hash") @db.Char(64)
  statusDescription String?     @map("status_description")
  lastGatewayError String?      @map("last_gateway_error")
  processedAt      DateTime?    @map("processed_at") @db.Timestamptz(3)
  lastSyncedAt     DateTime?    @map("last_synced_at") @db.Timestamptz(3)
  raw              Json?
  createdAt        DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([paymentOrderId])
  @@index([status, lastSyncedAt])
  @@map("refunds")
}

/// Append-only audit trail of every status change.
model PaymentEvent {
  id             String         @id @default(uuid()) @db.Uuid
  paymentOrderId String         @map("payment_order_id") @db.Uuid
  fromStatus     PaymentStatus? @map("from_status")
  toStatus       PaymentStatus  @map("to_status")
  source         EventSource
  note           String?
  payload        Json?
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  paymentOrder PaymentOrder @relation(fields: [paymentOrderId], references: [id], onDelete: Restrict)

  @@index([paymentOrderId, createdAt])
  @@map("payment_events")
}

/// Inbox of every webhook received from Cashfree (dedupe + replay + audit).
model WebhookEvent {
  id          String                  @id @default(uuid()) @db.Uuid
  /// sha256 of the raw body; Cashfree retries deliver the identical body.
  dedupeKey   String                  @unique @map("dedupe_key") @db.Char(64)
  eventType   String                  @map("event_type") @db.VarChar(64)
  orderId     String?                 @map("order_id") @db.VarChar(45)
  status      WebhookProcessingStatus @default(RECEIVED)
  attempts    Int                     @default(0)
  lastError   String?                 @map("last_error")
  payload     Json
  headers     Json
  receivedAt  DateTime                @default(now()) @map("received_at") @db.Timestamptz(3)
  processedAt DateTime?               @map("processed_at") @db.Timestamptz(3)

  @@index([status, receivedAt])
  @@index([orderId])
  @@map("webhook_events")
}

/// Transactional outbox: ERP notifications written in the same DB transaction as the state change.
model OutboxEvent {
  id            String       @id @default(uuid()) @db.Uuid
  aggregateId   String       @map("aggregate_id") @db.VarChar(64)
  eventType     String       @map("event_type") @db.VarChar(64)
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  lastError     String?      @map("last_error")
  /// NULL = deliver now. Only ever set from the database clock (now() + backoff), never an app server's.
  nextAttemptAt DateTime?    @map("next_attempt_at") @db.Timestamptz(3)
  lockedUntil   DateTime?    @map("locked_until") @db.Timestamptz(3)
  sentAt        DateTime?    @map("sent_at") @db.Timestamptz(3)
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([status, nextAttemptAt])
  @@index([aggregateId])
  @@map("outbox_events")
}
