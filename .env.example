NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://ums:ums@localhost:5433/ums_payments?schema=public

# Keys the ERP backend sends in the x-api-key header (comma-separated to allow rotation)
API_KEYS=change-me-erp-api-key

# Cashfree sandbox credentials: https://merchant.cashfree.com -> Developers -> API Keys (Test mode)
CASHFREE_ENV=sandbox
CASHFREE_CLIENT_ID=your_sandbox_app_id
CASHFREE_CLIENT_SECRET=your_sandbox_secret_key
CASHFREE_API_VERSION=2025-01-01
CASHFREE_TIMEOUT_MS=10000

# Public URL of this service (use an ngrok/cloudflared HTTPS URL locally so Cashfree can reach webhooks)
PUBLIC_BASE_URL=http://localhost:3000
DEFAULT_FRONTEND_RETURN_URL=http://localhost:5173/payments/result
ALLOWED_RETURN_ORIGINS=http://localhost:5173

PAYMENT_ORDER_TTL_MINUTES=30

# ERP endpoint that receives payment outcome events (leave empty to only log them)
ERP_WEBHOOK_URL=
ERP_WEBHOOK_SECRET=change-me-erp-webhook-secret

JOBS_ENABLED=true
RECONCILE_INTERVAL_SECONDS=60
RECONCILE_STALE_AFTER_SECONDS=300
OUTBOX_INTERVAL_SECONDS=10
OUTBOX_MAX_ATTEMPTS=10
